<Window x:Class="Plantagotchi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Plantagotchi"
        Icon="/icon.ico"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>

        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        IconSource="/icon.ico"
                        ToolTipText="Plantagotchi - Running in the background"
                        TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Plantagotchi"
                              Click="ShowApp_Click"
                              FontWeight="Bold"/>
                    <MenuItem Header="🔔 Test Notification"
                              Click="TestNotify_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit"
                              Click="ExitApp_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <materialDesign:DialogHost Identifier="RootDialog"
                                   IsOpen="{Binding IsEditDialogOpen}">

            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="25"
                            Width="320">
                    <TextBlock Text="Edit Plant Name"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>
                    <TextBox Text="{Binding EditPlantName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Plant Name"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Margin="0,0,0,30"
                             FontSize="16"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,10,0"
                                Cursor="Hand"/>
                        <Button Content="Save Changes"
                                Command="{Binding SaveEditCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>

            <materialDesign:DialogHost IsOpen="{Binding IsDetailsDialogOpen}">

                <materialDesign:DialogHost.DialogContent>
                    <Grid Margin="30"
                          Width="700"
                          Height="600">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="32"
                                                     Height="32"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedPlantForDetails.Name}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedPlantForDetails.ScientificName, StringFormat=' ({0})'}"
                                       FontSize="20"
                                       FontStyle="Italic"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding CloseDetailsDialogCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right"
                                    Margin="10,0,0,0">Close</Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,20,0">
                            <TextBlock Text="AI Care Guide"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Upload a photo to generate an AI Care Guide!"
                                       FontStyle="Italic"
                                       Opacity="0.6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlantForDetails.CareGuide}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Height="200"
                                          Margin="0,0,0,20">
                                <TextBlock Text="{Binding SelectedPlantForDetails.CareGuide}"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           LineHeight="24"/>
                            </ScrollViewer>

                            <Separator Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Health Diagnosis"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Command="{Binding DiagnosePlantCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30"
                                        Padding="10,0"
                                        Margin="15,0,0,0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Stethoscope"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Examine Now"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal"
                                            Margin="15,0,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiagnosing}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Value="0"
                                                 IsIndeterminate="True"
                                                 Width="20"
                                                 Height="20"/>
                                    <TextBlock Text=" Examining..."
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"
                                               Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Click 'Examine Now' to let the AI check for diseases or pests based on the latest photo."
                                       FontStyle="Italic"
                                       Opacity="0.6"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlantForDetails.LastDiagnosis}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlantForDetails.LastDiagnosis}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedPlantForDetails.LastDiagnosisDate, StringFormat='{}Examined on: {0:yyyy. MM. dd. HH:mm}'}"
                                           FontSize="12"
                                           Opacity="0.6"
                                           Margin="0,0,0,5"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Height="120">
                                    <TextBlock Text="{Binding SelectedPlantForDetails.LastDiagnosis}"
                                               TextWrapping="Wrap"
                                               FontSize="15"
                                               LineHeight="24"
                                               FontWeight="Medium"/>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBlock Text="Timeline"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding SelectedPlantForDetails.Images}"
                                     Height="480"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="0,0,0,15"
                                                             Padding="5"
                                                             UniformCornerRadius="8">
                                            <StackPanel>
                                                <Image Stretch="UniformToFill"
                                                       Source="{Binding ImagePath}"
                                                       Height="150"/>
                                                <TextBlock Text="{Binding UploadDate, StringFormat='{}{0:yyyy. MM. dd. HH:mm}'}"
                                                           TextAlignment="Center"
                                                           Margin="0,5,0,0"
                                                           Opacity="0.7"/>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </materialDesign:DialogHost.DialogContent>

                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0"
                                         Margin="0,0,30,0"
                                         Padding="20"
                                         VerticalAlignment="Top"
                                         UniformCornerRadius="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,25">
                                <materialDesign:PackIcon Kind="Leaf"
                                                         Width="30"
                                                         Height="30"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Text="Plantagotchi"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Add New Plant"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="Give it a name and upload a photo! The AI will identify it and set the optimal watering schedule automatically."
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Margin="0,0,0,25"
                                       FontStyle="Italic"
                                       FontSize="13"/>
                            <TextBox Text="{Binding NewPlantName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Plant Name (e.g. Living Room Cactus)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,30"
                                     FontSize="16"/>
                            <Button Command="{Binding AddPlantCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="45"
                                    FontSize="16"
                                    Cursor="Hand"
                                    materialDesign:ButtonAssist.CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Plant"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="My Plants"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,15,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearching}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Value="0"
                                                 IsIndeterminate="True"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"/>
                                    <TextBlock Text="AI is working..."
                                               Opacity="0.6"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <materialDesign:Card Background="#2196F3"
                                                     Foreground="White"
                                                     Padding="10,5"
                                                     UniformCornerRadius="15"
                                                     Margin="0,0,15,0">
                                    <StackPanel Orientation="Horizontal"
                                                ToolTip="Current Local Weather">
                                        <materialDesign:PackIcon Kind="Thermometer"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,5,0"
                                                                 Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentWeather}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                        <Button Command="{Binding ForceRefreshWeatherCommand}"
                                                Style="{StaticResource MaterialDesignToolButton}"
                                                Foreground="White"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Margin="5,0,0,0"
                                                ToolTip="Force update AI forecast">
                                            <materialDesign:PackIcon Kind="Refresh"
                                                                     Width="16"
                                                                     Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:PackIcon Kind="WeatherSunny"
                                                         Width="20"
                                                         Height="20"
                                                         Opacity="0.6"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,5,0"/>
                                <ToggleButton x:Name="ThemeToggle"
                                              IsChecked="True"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Click="ThemeToggle_Click"
                                              Cursor="Hand"/>
                                <materialDesign:PackIcon Kind="WeatherNight"
                                                         Width="20"
                                                         Height="20"
                                                         Opacity="0.6"
                                                         VerticalAlignment="Center"
                                                         Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="🔍 Search plants..."
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Margin="0,0,10,15"
                                 FontSize="16"/>

                        <StackPanel Grid.Row="2"
                                    Margin="0,0,10,15">
                            <materialDesign:Card Background="#FFF9C4"
                                                 Foreground="#333"
                                                 Padding="15"
                                                 UniformCornerRadius="8"
                                                 VerticalAlignment="Top"
                                                 Margin="0,0,0,10">
                                <materialDesign:Card.Style>
                                    <Style TargetType="materialDesign:Card">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowWeatherAlerts}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Card.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="AlertDecagramOutline"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="#FF9800"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,0,10,0"/>
                                        <TextBlock Text="Weather Advisory for the week:"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding WeatherAlerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding PlantName}"
                                                               FontWeight="Bold"
                                                               FontSize="14"/>
                                                    <TextBlock Text="{Binding AlertMessage}"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.8"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Background="#E8F5E9"
                                                 Foreground="#1B5E20"
                                                 Padding="15"
                                                 UniformCornerRadius="8"
                                                 VerticalAlignment="Top">
                                <materialDesign:Card.Style>
                                    <Style TargetType="materialDesign:Card">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPositiveWeatherMessage}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Card.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                             Width="24"
                                                             Height="24"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="All good! The upcoming weather is fine for your plants."
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding PlantsView}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="0,0,10,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,15"
                                                         Padding="20"
                                                         UniformCornerRadius="10">

                                        <materialDesign:Card.Style>
                                            <Style TargetType="materialDesign:Card">
                                                <Setter Property="Background"
                                                        Value="#F1F8E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWeatherAlert}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#FFFDE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsWatering}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#FFF1F0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:Card.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0"
                                                  Margin="0,0,15,0">
                                                <materialDesign:PackIcon Kind="ImageOutline"
                                                                         Width="40"
                                                                         Height="40"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Opacity="0.2">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LatestImagePath}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <Border CornerRadius="8"
                                                        ClipToBounds="True">
                                                    <Image Stretch="UniformToFill"
                                                           Source="{Binding LatestImagePath}"
                                                           Width="100"
                                                           Height="100"/>
                                                </Border>
                                                <Button Command="{Binding DataContext.UploadImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                                        Width="32"
                                                        Height="32"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="5"
                                                        ToolTip="Upload Photo"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="CameraPlus"
                                                                             Width="16"
                                                                             Height="16"
                                                                             Foreground="#444"/>
                                                </Button>
                                            </Grid>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="#333"/>
                                                    <TextBlock Text="{Binding ScientificName, StringFormat=' ({0})'}"
                                                               FontSize="16"
                                                               FontStyle="Italic"
                                                               Opacity="0.8"
                                                               Foreground="#333"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScientificName}"
                                                                                 Value="{x:Null}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,5,0,0">
                                                    <materialDesign:PackIcon Kind="CalendarClock"
                                                                             Opacity="0.8"
                                                                             Foreground="#333"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding LastWatered, StringFormat='Last Watered: {0:yyyy. MM. dd.}'}"
                                                               Foreground="#333"
                                                               Opacity="0.8"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <materialDesign:PackIcon Kind="CalendarArrowRight"
                                                                             Foreground="#0277BD"
                                                                             Opacity="0.9"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding NextWateringDate, StringFormat='{}Next Water: {0:yyyy. MM. dd.}'}"
                                                               Foreground="#0277BD"
                                                               Opacity="0.9"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,10,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsWatering}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                                             Foreground="#D32F2F"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0"/>
                                                    <TextBlock Text="Needs Water!"
                                                               Foreground="#D32F2F"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,6,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWeatherAlert}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <materialDesign:PackIcon Kind="WeatherCloudy"
                                                                             Foreground="#F57F17"
                                                                             VerticalAlignment="Top"
                                                                             Margin="0,2,6,0"/>
                                                    <TextBlock Text="{Binding WeatherAlertMessage}"
                                                               Foreground="#4E342E"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               FontStyle="Italic"
                                                               MaxWidth="380"/>
                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.OpenDetailsDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        ToolTip="Info &amp; Timeline"
                                                        Background="#4CAF50"
                                                        BorderBrush="#4CAF50"
                                                        Margin="0,0,10,0"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="InformationVariant"
                                                                             Width="20"
                                                                             Height="20"
                                                                             Foreground="White"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.WaterPlantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        ToolTip="Water Now"
                                                        Background="#2196F3"
                                                        BorderBrush="#2196F3"
                                                        Margin="0,0,10,0"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="Water"
                                                                             Width="20"
                                                                             Height="20"
                                                                             Foreground="White"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        ToolTip="Edit Plant"
                                                        Background="#FF9800"
                                                        BorderBrush="#FF9800"
                                                        Margin="0,0,10,0"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="Pencil"
                                                                             Width="20"
                                                                             Height="20"
                                                                             Foreground="White"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeletePlantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        ToolTip="Delete"
                                                        Background="#F44336"
                                                        BorderBrush="#F44336"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="TrashCan"
                                                                             Width="20"
                                                                             Height="20"
                                                                             Foreground="White"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>
    </Grid>
</Window>